name: Build APK do Balcão (Nuvita Kiosk)
on:
  push:
    branches: [main]
    paths: ['android-kiosk/**', '.github/workflows/build-apk.yml']
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3
      - run: sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0"
      - working-directory: android-kiosk
        run: gradle wrapper --gradle-version 8.7 --no-daemon
      - working-directory: android-kiosk
        run: ./gradlew assembleDebug --no-daemon --stacktrace
      - uses: actions/upload-artifact@v4
        with:
          name: nuvita-balcao-apk
          path: android-kiosk/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
