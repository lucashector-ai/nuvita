####################################################################
# NUVITA — variáveis de ambiente (copie para .env.local e preencha)
#
# REGRAS DE SEGURANÇA:
#  - NUNCA commitar .env.local / .env.production
#  - Variáveis prefixadas NEXT_PUBLIC_* SÃO EMBUTIDAS NO BUNDLE
#    do cliente. Use SOMENTE para valores realmente públicos.
#  - Tudo o mais é server-only (API routes / build).
####################################################################

# ─── Supabase ───────────────────────────────────────────────────
# Anon key é pública (vai pro bundle). RLS é o que protege os dados.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role: SEGREDO. Bypassa RLS. Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Anthropic (IA) ─────────────────────────────────────────────
# SEGREDO. Use apenas server-side via /api/ia ou /api/chat.
# Nunca prefixar com NEXT_PUBLIC_ — abriria a chave para o mundo.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Resend (email transacional) ────────────────────────────────
RESEND_API_KEY=re_...

# ─── Painel admin ───────────────────────────────────────────────
# Token server-only. NUNCA prefixar com NEXT_PUBLIC_.
# Gere com: openssl rand -hex 32
ADMIN_TOKEN=GERAR_COM_OPENSSL_RAND_HEX_32

# Lista de emails que recebem acesso de admin via sessão Supabase.
# Separar por vírgula. Recomendado em vez do ADMIN_TOKEN puro.
ADMIN_EMAILS=fundador@nuvita.app,ops@nuvita.app

# ─── Comunicação interna entre rotas (webhook → /api/email) ─────
# Token server-only que o webhook do Stripe envia em x-internal-secret
# para se autenticar com a rota de email. Sem ele, a rota /api/email
# rejeita callers externos para templates de pagamento.
# Gere com: openssl rand -hex 32
INTERNAL_API_SECRET=GERAR_COM_OPENSSL_RAND_HEX_32

# ─── App URL pública ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nuvita-l1wk.vercel.app

# ─── WhatsApp via Nexxus (relay) ────────────────────────────────
# O número está conectado à Meta pela Nexxus. O balcão envia o PDF para o
# endpoint da Nexxus, que dispara pelo número — o token da Meta fica só na
# Nexxus. Ambos server-only. NUNCA prefixar com NEXT_PUBLIC_.
NEXXUS_WHATSAPP_URL=https://shop.nexxuslabs.de
NEXXUS_RELAY_TOKEN=MESMO_VALOR_DO_WHATSAPP_RELAY_TOKEN_NA_NEXXUS

####################################################################
# VARIÁVEIS QUE FORAM REMOVIDAS POR SEREM INSEGURAS:
#   NEXT_PUBLIC_ADMIN_TOKEN  → vazava o token no bundle JS
#   NEXT_PUBLIC_MEDICO_TOKEN → idem
# Substituídas por ADMIN_TOKEN (server-only) + login validado em /api/admin.
####################################################################
